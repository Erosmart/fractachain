{
  "name": "@fractachain/api",
  "version": "2.0.0",
  "private": true,
  "description": "Backend de Fractachain (librería): dominio, aplicación, infraestructura y HTTP. Corre dentro del servidor de la web (apps/web) o solo.",
  "main": "dist/platform/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:licitacion": "tsx src/cli/deploy-licitacion.ts",
    "deploy:forward-warrant": "tsx src/cli/deploy-forward-warrant.ts",
    "init:forward-warrant": "tsx src/cli/init-forward-warrant.ts",
    "testnet:clone-factory": "tsx src/cli/clone-factory.ts",
    "testnet:setup-usdc": "tsx src/cli/setup-usdc.ts",
    "testnet:upload-wasm": "tsx src/cli/upload-wasm.ts",
    "stellar:deploy": "tsx src/cli/stellar-deploy.ts",
    "stellar:fund-pool": "tsx src/cli/stellar-fund-pool.ts",
    "stellar:fund": "tsx src/cli/stellar-fund.ts",
    "stellar:e2e": "tsx src/cli/stellar-e2e.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.14",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fractachain/shared": "*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "types": "dist/platform/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/platform/index.d.ts",
      "default": "./dist/platform/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data"
  ]
}
