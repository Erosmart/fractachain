# Fractachain — copiá a `.env` (gitignored). Un solo archivo para la app
# entera: la web (Astro) y el API corren en el mismo servidor.
#
#   PUBLIC_*  → se incrustan en el bundle del navegador al compilar (nunca secretos).
#   resto     → solo servidor, se leen al arrancar.

# ============================================================ servidor
NODE_ENV=development
PORT=3000
# LOG_LEVEL=info
# Proxies delante (Railway = 1). En producción el default es 1.
# TRUST_PROXY=1
# URL pública de la app (links de los emails de verificación y reseteo).
APP_URL=http://localhost:3000
# Orígenes extra que pueden llamar al API (solo si hay un frontend en otro dominio).
# CORS_ORIGINS=

# ---------------------------------------------------------------- seguridad
# Firma de sesiones (HMAC-SHA256). 32+ caracteres: `openssl rand -hex 32`.
AUTH_SECRET=
SESSION_TTL_HOURS=12
# Cifra las wallets custodiales y los secretos de 2FA (AES-256-GCM). No lo
# cambies sin poner el valor anterior en WALLET_PEPPER_PREVIOUS.
WALLET_PEPPER=
# WALLET_PEPPER_PREVIOUS=

# Admins (coma). Las cuentas se reservan al arrancar.
ADMIN_EMAILS=admin@fractachain.local
# Contraseña inicial del admin (solo si la cuenta todavía no tiene una).
ADMIN_BOOTSTRAP_PASSWORD=
# 2FA (TOTP) obligatorio para el panel de admin. Default: sí en producción.
# ADMIN_REQUIRE_2FA=true
# Email verificado antes del KYC (cuentas email/contraseña). Default: sí en producción.
# REQUIRE_EMAIL_VERIFICATION=true

# Envío de emails. Sin SMTP_URL los emails se escriben en el log (desarrollo).
# SMTP_URL=smtps://usuario:clave@smtp.proveedor.com:465
# MAIL_FROM=Fractachain <no-reply@tu-dominio>

# Login con Google: el servidor verifica el ID token de Firebase con este proyecto.
# FIREBASE_PROJECT_ID=

# ---------------------------------------------------------------- demo
HACKATHON_DEMO=true
# DEMO_SEED_ACCOUNTS=true        # test@fractachain.dev / test1234 (off en producción)
# KYC_AUTO_APPROVE=true
# KYC_ENFORCE_HOURS=false

# ---------------------------------------------------------------- persistencia
# DATA_DIR=./packages/api/data
# Con DATABASE_URL: espejo + restore en Postgres y locks distribuidos (advisory locks).
# DATABASE_URL=postgres://user:pass@host:5432/db

# ---------------------------------------------------------------- Stellar testnet
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# STELLAR_DEPLOYMENT_FILE=./deployments/testnet.json
# Claves S… de la plataforma. Las que falten se provisionan con Friendbot y se
# agregan a este archivo. Tienen que coincidir con deployments/testnet.json.
STELLAR_DEPLOYER_SECRET=
STELLAR_ISSUER_SECRET=
# STELLAR_USDC_ISSUER_SECRET=
# STELLAR_LICITACION_ADMIN_SECRET=
# STELLAR_POR_ORACLE_SECRET=
STELLAR_USDC_CODE=USDC

# ============================================================ navegador (PUBLIC_*)
# Vacío = el API está en este mismo servidor (lo normal). Solo se completa si
# el API vive en otro dominio.
PUBLIC_API_URL=
PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# Firebase (opcional, login con Google). Agregá el dominio en Firebase →
# Authentication → Settings → Authorized domains.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
