# Keep the build context small and secret-free.
.git
.github
**/node_modules
**/dist
**/.astro
**/coverage
**/*.tsbuildinfo
**/.env
**/.env.*
!**/.env.example
**/*.secret
**/*.secret.json
agents_secrets.json
deployments/*.local.json
deployments/wasm
contracts/target
graphify-out

# Runtime state never belongs in an image
apps/api/.local-data
apps/api/data/users.json
apps/api/data/selfies
apps/api/data/dividends.json
apps/api/data/kyc.json
apps/api/data/revoked-sessions.json
apps/api/legacy-src
apps/web/legacy-next-src

# Not needed to build the services
docs
tools
.agents
**/.cursor
**/.vscode
**/agent-transcripts
