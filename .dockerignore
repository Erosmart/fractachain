# Keep the build context small and secret-free.
.git
.github
**/node_modules
**/dist
**/.astro
**/coverage
**/*.tsbuildinfo
**/.env
**/.env.*
!**/.env.example
**/*.secret
**/*.secret.json
agents_secrets.json
deployments/*.local.json
deployments/wasm
contracts/target
graphify-out

# Runtime state never belongs in an image
packages/api/data/audit.json
packages/api/.local-data
packages/api/data/users.json
packages/api/data/selfies
packages/api/data/dividends.json
packages/api/data/kyc.json
packages/api/data/revoked-sessions.json

# Not needed to build the services
docs
tools
.agents
**/.cursor
**/.vscode
**/agent-transcripts
