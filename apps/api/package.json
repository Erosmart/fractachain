{
  "name": "@fractachain/api",
  "version": "2.0.0",
  "private": true,
  "description": "Fractachain API \u2014 Express 5 + TypeScript, arquitectura por capas (domain / application / infrastructure / http).",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:licitacion": "tsx src/cli/deploy-licitacion.ts",
    "deploy:forward-warrant": "tsx src/cli/deploy-forward-warrant.ts",
    "init:forward-warrant": "tsx src/cli/init-forward-warrant.ts",
    "testnet:clone-factory": "tsx src/cli/clone-factory.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.14",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fractachain/shared": "*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
