# Fractachain API — copiá a apps/api/.env (gitignored). Nunca subas el .env real.
NODE_ENV=development
PORT=4000
# LOG_LEVEL=info
# Proxies delante del API (Railway = 1). En producción el default es 1.
# TRUST_PROXY=1

# Orígenes del frontend permitidos por CORS (coma). En desarrollo también se
# aceptan localhost y la LAN (192.168.x.x) para probar desde el celular.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- seguridad
# Firma de sesiones (HMAC-SHA256). 32+ caracteres aleatorios: `openssl rand -hex 32`.
# En producción el API no arranca sin esto (AUTH_PEPPER se acepta como nombre viejo).
AUTH_SECRET=
# Duración de la sesión en horas.
SESSION_TTL_HOURS=12
# Cifra las claves de las wallets custodiales (AES-256-GCM). No lo cambies sin
# poner el valor anterior en WALLET_PEPPER_PREVIOUS: si no, esas wallets se pierden.
WALLET_PEPPER=
# WALLET_PEPPER_PREVIOUS=

# Admins (coma). Las cuentas se reservan al arrancar: nadie más puede registrarlas.
ADMIN_EMAILS=admin@fractachain.local
# Contraseña inicial del admin (solo se aplica si la cuenta todavía no tiene una).
# Sin esto, el admin ingresa con Google (email verificado).
ADMIN_BOOTSTRAP_PASSWORD=

# Login con Google: el API verifica el ID token de Firebase con este proyecto.
# Sin esto, /api/auth/firebase responde 503 y queda solo email + contraseña.
# FIREBASE_PROJECT_ID=

# ---------------------------------------------------------------- demo
# KYC auto-aprobado y cuentas nuevas aprobadas (demo del hackathon).
HACKATHON_DEMO=true
# Cuenta test@fractachain.dev / test1234 (por defecto: sí fuera de producción).
# DEMO_SEED_ACCOUNTS=true
# KYC_AUTO_APPROVE=true
# KYC_ENFORCE_HOURS=false

# ---------------------------------------------------------------- persistencia
# DATA_DIR=./data
# Con DATABASE_URL el estado se espeja en Postgres y se restaura al arrancar.
# DATABASE_URL=postgres://user:pass@host:5432/db

# ---------------------------------------------------------------- Stellar testnet
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# STELLAR_DEPLOYMENT_FILE=../../deployments/testnet.json

# Claves S… de la plataforma (testnet). Las que falten se provisionan solas con
# Friendbot y se agregan a este archivo. Tienen que coincidir con deployments/testnet.json.
STELLAR_DEPLOYER_SECRET=
STELLAR_ISSUER_SECRET=
# STELLAR_USDC_ISSUER_SECRET=
# STELLAR_LICITACION_ADMIN_SECRET=
# STELLAR_POR_ORACLE_SECRET=
STELLAR_USDC_CODE=USDC
