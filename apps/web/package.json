{
  "name": "@fractachain/web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Fractachain: aplicación única — Astro (SSR, adaptador Node en modo middleware) + API en el mismo servidor.",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 3000",
    "build": "astro build",
    "start": "node server/main.mjs",
    "typecheck": "astro check",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@astrojs/node": "11.1.9",
    "@astrojs/react": "7.1.2",
    "@firebase/app": "^0.16.4",
    "@firebase/auth": "^1.13.8",
    "@fractachain/api": "*",
    "@stellar/freighter-api": "^6.0.1",
    "astro": "7.4.1",
    "lucide-react": "^0.577.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@fractachain/shared": "*",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
