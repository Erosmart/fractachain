# Fractachain web (Astro) — variables públicas.
# Todo lo que empieza con PUBLIC_ se incrusta en el bundle del navegador al
# compilar: nunca pongas secretos acá. Cambiar un valor implica re-build.

# URL pública del API. Si apunta a localhost y abrís la web desde otra máquina
# de la LAN, el cliente la reescribe al host de la página (mismo puerto).
PUBLIC_API_URL=http://localhost:4000

# Stellar (testnet)
PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Firebase Auth (opcional). Sin estas claves el login con Google se oculta en
# la práctica (avisa que no está configurado) y email/Freighter siguen andando.
# El backend también necesita FIREBASE_PROJECT_ID para verificar el idToken.
# Firebase Console > Configuración del proyecto > General > Tus apps > Web app.
# Agregá el dominio de la web en Authentication > Settings > Authorized domains.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
