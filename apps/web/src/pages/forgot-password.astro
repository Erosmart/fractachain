---
import ForgotPasswordPage from '@/features/auth/components/ForgotPasswordPage';
import PageFallback from '@/components/ui/PageFallback.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { translate } from '@/core/i18n/translate';

const locale = Astro.locals.locale;
---

<BaseLayout title={translate(locale, 'pwd.forgotTitle')}>
  <ForgotPasswordPage client:only="react" locale={locale}>
    <PageFallback slot="fallback" />
  </ForgotPasswordPage>
</BaseLayout>
