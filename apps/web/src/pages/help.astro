---
import HelpCenter from '@/features/legal/components/HelpCenter';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { messagesFor } from '@/core/i18n/translate';

const locale = Astro.locals.locale;
const help = messagesFor(locale).legal.help;
---

<BaseLayout title={help.title} description={help.lead}>
  <div class="mx-auto max-w-[1180px] space-y-8">
    <header class="max-w-3xl">
      <p class="eyebrow">{help.eyebrow}</p>
      <h1 class="mt-2 text-[30px] font-normal leading-tight tracking-[-0.025em] text-ink sm:text-[38px]">
        {help.title}
      </h1>
      <p class="mt-3 text-[15px] leading-relaxed text-ink-2 sm:text-base">{help.lead}</p>
    </header>
    <HelpCenter client:load locale={locale} />
  </div>
</BaseLayout>
