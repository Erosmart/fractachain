---
import ContactPage from '@/features/support/components/ContactPage';
import PageFallback from '@/components/ui/PageFallback.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { translate } from '@/core/i18n/translate';

const locale = Astro.locals.locale;
---

<BaseLayout
  title={translate(locale, 'support.contact.eyebrow')}
  description={translate(locale, 'support.contact.lead')}
>
  <ContactPage client:only="react" locale={locale}>
    <PageFallback slot="fallback" />
  </ContactPage>
</BaseLayout>
