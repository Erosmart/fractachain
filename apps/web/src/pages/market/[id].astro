---
import MarketDetailPage from '@/features/market/components/MarketDetailPage';
import PageFallback from '@/components/ui/PageFallback.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { translate } from '@/core/i18n/translate';

const locale = Astro.locals.locale;
---

<BaseLayout title={translate(locale, 'market.dossier')}>
  <MarketDetailPage client:only="react" locale={locale} listingId={Astro.params.id ?? ''}>
    <PageFallback slot="fallback" />
  </MarketDetailPage>
</BaseLayout>
