---
import SecurityPage from '@/features/account/components/SecurityPage';
import SectionNav from '@/components/layout/SectionNav';
import PageFallback from '@/components/ui/PageFallback.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { translate } from '@/core/i18n/translate';

const locale = Astro.locals.locale;
---

<BaseLayout title={translate(locale, 'sec.title')}>
  <div class="mx-auto flex max-w-6xl flex-col gap-6">
    <SectionNav section="account" active="security" client:load locale={locale} className="self-start" />
    <SecurityPage client:only="react" locale={locale}>
      <PageFallback slot="fallback" />
    </SecurityPage>
  </div>
</BaseLayout>
