---
import HomePage from '@/features/home/components/HomePage';
import PageFallback from '@/components/ui/PageFallback.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { translate } from '@/core/i18n/translate';

const locale = Astro.locals.locale;
---

<BaseLayout title={translate(locale, 'dashboard.title')}>
  <HomePage client:only="react" locale={locale}>
    <PageFallback slot="fallback" />
  </HomePage>
</BaseLayout>
