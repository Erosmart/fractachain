---
import RegisterPage from '@/features/auth/components/RegisterPage';
import PageFallback from '@/components/ui/PageFallback.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { translate } from '@/core/i18n/translate';

const locale = Astro.locals.locale;
---

<BaseLayout title={translate(locale, 'account.signup.title')} bare>
  <RegisterPage client:only="react" locale={locale}>
    <PageFallback slot="fallback" />
  </RegisterPage>
</BaseLayout>
