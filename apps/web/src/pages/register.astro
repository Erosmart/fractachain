---
/**
 * Sign-up and sign-in are the same flow: the first email login creates the
 * account. Old links land on the login page in sign-up mode.
 */
const next = Astro.url.searchParams.get('next');
const target = new URLSearchParams({ mode: 'register' });
if (next && next.startsWith('/') && !next.startsWith('//')) target.set('next', next);
return Astro.redirect(`/login?${target}`, 308);
---
