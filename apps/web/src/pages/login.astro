---
import LoginPage from '@/features/auth/components/LoginPage';
import PageFallback from '@/components/ui/PageFallback.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { translate } from '@/core/i18n/translate';

// Sign-up has its own page now; old `/login?mode=register` links land there.
if (Astro.url.searchParams.get('mode') === 'register') {
  const next = Astro.url.searchParams.get('next');
  const target =
    next && next.startsWith('/') && !next.startsWith('//') ? `?next=${encodeURIComponent(next)}` : '';
  return Astro.redirect(`/register${target}`, 308);
}

const locale = Astro.locals.locale;
---

<BaseLayout title={translate(locale, 'nav.login')} bare>
  <LoginPage client:only="react" locale={locale}>
    <PageFallback slot="fallback" />
  </LoginPage>
</BaseLayout>
