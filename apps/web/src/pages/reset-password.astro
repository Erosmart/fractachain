---
import ResetPasswordPage from '@/features/auth/components/ResetPasswordPage';
import PageFallback from '@/components/ui/PageFallback.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { translate } from '@/core/i18n/translate';

const locale = Astro.locals.locale;
---

<BaseLayout title={translate(locale, 'pwd.resetTitle')} bare>
  <ResetPasswordPage client:only="react" locale={locale}>
    <PageFallback slot="fallback" />
  </ResetPasswordPage>
</BaseLayout>
