---
import StocksPage from '@/features/stocks/components/StocksPage';
import MarketsHeader from '@/features/market/components/MarketsHeader.astro';
import PageFallback from '@/components/ui/PageFallback.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { translate } from '@/core/i18n/translate';

const locale = Astro.locals.locale;
---

<BaseLayout title={translate(locale, 'markets.stocks.title')}>
  <MarketsHeader active="stocks" title="markets.stocks.title" subtitle="markets.stocks.subtitle" />
  <StocksPage client:only="react" locale={locale}>
    <PageFallback slot="fallback" />
  </StocksPage>
</BaseLayout>
