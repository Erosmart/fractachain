---
import { ArrowRight, Building2, Clock3 } from 'lucide-react';
import Ecosystem from '@/components/marketing/Ecosystem.astro';
import Faq from '@/components/marketing/Faq.astro';
import FinalCta from '@/components/marketing/FinalCta.astro';
import Issuers from '@/components/marketing/Issuers.astro';
import Products from '@/components/marketing/Products.astro';
import Regulation from '@/components/marketing/Regulation.astro';
import SectionHeading from '@/components/marketing/SectionHeading.astro';
import Security from '@/components/marketing/Security.astro';
import { WireframeAsset } from '@/components/ui/kit';
import HeroFacts from '@/features/landing/components/HeroFacts';
import HeroLivePanel from '@/features/landing/components/HeroLivePanel';
import HowItWorks from '@/features/landing/components/HowItWorks';
import OfferingCards from '@/features/landing/components/OfferingCards';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { messagesFor } from '@/core/i18n/translate';

const locale = Astro.locals.locale;
const { landing } = messagesFor(locale);
const h = landing.hero;
const steps = landing.how.investorSteps;
---

<BaseLayout width="full">
  <div class="mx-auto max-w-[1440px] space-y-20 px-4 pt-5 sm:space-y-28 sm:px-6 sm:pt-7 lg:px-8">
    <!-- Hero: promise + wireframe on the left, live numbers on the gradient panel -->
    <section aria-labelledby="hero-title" class="space-y-4">
      <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_400px]">
        <div class="card relative flex min-h-[520px] flex-col overflow-hidden bg-surface/70 p-6 backdrop-blur-sm sm:p-10">
          <ul class="flex flex-wrap gap-1.5" aria-label={h.chips.join(', ')}>
            {h.chips.map((chip, i) => (
              <li class={`chip ${i === 2 ? 'chip-butter dark:text-navy-ink' : 'chip-neutral'}`}>{chip}</li>
            ))}
          </ul>
          <h1
            id="hero-title"
            class="mt-8 max-w-[15ch] text-[40px] font-light leading-[1.02] tracking-[-0.04em] text-ink sm:text-[64px] xl:text-[72px]"
          >
            {h.title}
          </h1>
          <p class="mt-5 max-w-xl text-[16px] text-ink-2 sm:text-[17px]">{h.lead}</p>
          <div class="mt-8 flex flex-col gap-2.5 sm:flex-row">
            <a href="/market" class="btn btn-primary btn-lg">
              {h.ctaInvest}
              <ArrowRight className="h-4 w-4" aria-hidden="true" />
            </a>
            <a href="/contacto?tema=emisor" class="btn btn-secondary btn-lg">
              <Building2 className="h-4 w-4" aria-hidden="true" />
              {h.ctaIssuer}
            </a>
          </div>

          <WireframeAsset className="pointer-events-none mt-10 w-full max-w-[560px] self-end lg:absolute lg:-right-6 lg:bottom-6 lg:mt-0 lg:w-[54%] xl:w-[50%]" />

          <div class="relative mt-auto flex flex-wrap gap-2 pt-8">
            <span class="inline-flex h-8 items-center gap-2 rounded-lg border border-line bg-surface px-3 text-xs font-medium text-ink">
              <span class="h-1.5 w-1.5 rounded-full bg-ink" aria-hidden="true"></span>
              {h.readChip}
            </span>
            <span class="inline-flex h-8 items-center gap-2 rounded-lg border border-line bg-surface px-3 text-xs font-medium text-ink">
              <Clock3 className="h-3.5 w-3.5 text-ink-2" aria-hidden="true" />
              {h.nextChip}
            </span>
          </div>
        </div>

        {/* client:only: the gauge's trigonometry differs in the last float digit between Node and browsers. */}
        <HeroLivePanel client:only="react" locale={locale}>
          <div slot="fallback" class="gradient-panel min-h-[560px]" aria-hidden="true"></div>
        </HeroLivePanel>
      </div>

      <!-- Three facts, in the shape of the reference's task rows -->
      <HeroFacts
        facts={[
          { title: steps[1][0], subtitle: landing.security.items[2][1] },
          { title: landing.security.items[3][0], subtitle: landing.security.items[3][1] },
          { title: h.refundFact, subtitle: h.refundFactBody, badge: '100%' },
        ]}
      />
    </section>

    <section aria-labelledby="offerings-title" class="space-y-6">
      <SectionHeading
        id="offerings-title"
        eyebrow={landing.offerings.eyebrow}
        title={landing.offerings.title}
        lead={landing.offerings.lead}
      >
        <a href="/market" class="btn btn-secondary shrink-0">
          {landing.offerings.viewAll}
          <ArrowRight className="h-4 w-4" aria-hidden="true" />
        </a>
      </SectionHeading>
      <div>
        <OfferingCards client:idle locale={locale} />
      </div>
    </section>

    <section id="como-funciona" aria-labelledby="how-title" class="scroll-mt-24 space-y-6">
      <SectionHeading id="how-title" eyebrow={landing.how.eyebrow} title={landing.how.title} />
      <div>
        <HowItWorks client:visible locale={locale} />
      </div>
    </section>

    <Products />
    <Regulation />
    <Issuers />
    <Security />
    <Ecosystem />
    <Faq />
    <FinalCta />
  </div>
</BaseLayout>
