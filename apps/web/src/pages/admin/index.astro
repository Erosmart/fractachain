---
import AdminOverviewPage from '@/features/admin/overview/components/AdminOverviewPage';
import SectionNav from '@/components/layout/SectionNav';
import PageFallback from '@/components/ui/PageFallback.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { translate } from '@/core/i18n/translate';

const locale = Astro.locals.locale;
---

<BaseLayout title={translate(locale, 'admin.overview.title')}>
  <div class="space-y-6">
    <SectionNav section="console" active="overview" client:load locale={locale} />
    <AdminOverviewPage client:only="react" locale={locale}>
      <PageFallback slot="fallback" />
    </AdminOverviewPage>
  </div>
</BaseLayout>
