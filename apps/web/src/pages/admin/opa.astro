---
import AdminOpaPage from '@/features/admin/opa/components/AdminOpaPage';
import PageFallback from '@/components/ui/PageFallback.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { translate } from '@/core/i18n/translate';

const locale = Astro.locals.locale;
---

<BaseLayout title={translate(locale, 'admOpa.title')}>
  <AdminOpaPage client:only="react" locale={locale}>
    <PageFallback slot="fallback" />
  </AdminOpaPage>
</BaseLayout>
