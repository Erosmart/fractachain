---
import AdminIssuancePage from '@/features/admin/issuance/components/AdminIssuancePage';
import SectionNav from '@/components/layout/SectionNav';
import PageFallback from '@/components/ui/PageFallback.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { translate } from '@/core/i18n/translate';

const locale = Astro.locals.locale;
---

<BaseLayout title={translate(locale, 'admin.issuance.title')}>
  <div class="space-y-6">
    <SectionNav section="console" active="issuance" client:load locale={locale} />
    <AdminIssuancePage client:only="react" locale={locale}>
      <PageFallback slot="fallback" />
    </AdminIssuancePage>
  </div>
</BaseLayout>
