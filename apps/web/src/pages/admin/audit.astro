---
import AdminAuditPage from '@/features/admin/audit/components/AdminAuditPage';
import SectionNav from '@/components/layout/SectionNav';
import PageFallback from '@/components/ui/PageFallback.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { translate } from '@/core/i18n/translate';

const locale = Astro.locals.locale;
---

<BaseLayout title={translate(locale, 'admin.audit.title')}>
  <div class="space-y-6">
    <SectionNav section="console" active="audit" client:load locale={locale} />
    <AdminAuditPage client:only="react" locale={locale}>
      <PageFallback slot="fallback" />
    </AdminAuditPage>
  </div>
</BaseLayout>
