---
import AdminKycPage from '@/features/admin/kyc/components/AdminKycPage';
import PageFallback from '@/components/ui/PageFallback.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { translate } from '@/core/i18n/translate';

const locale = Astro.locals.locale;
---

<BaseLayout title={translate(locale, 'admKyc.title')}>
  <AdminKycPage client:only="react" locale={locale}>
    <PageFallback slot="fallback" />
  </AdminKycPage>
</BaseLayout>
