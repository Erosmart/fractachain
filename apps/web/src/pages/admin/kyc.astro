---
import AdminKycPage from '@/features/admin/kyc/components/AdminKycPage';
import SectionNav from '@/components/layout/SectionNav';
import PageFallback from '@/components/ui/PageFallback.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { translate } from '@/core/i18n/translate';

const locale = Astro.locals.locale;
---

<BaseLayout title={translate(locale, 'admin.kyc.title')}>
  <div class="space-y-6">
    <SectionNav section="console" active="kyc" client:load locale={locale} />
    <AdminKycPage client:only="react" locale={locale}>
      <PageFallback slot="fallback" />
    </AdminKycPage>
  </div>
</BaseLayout>
