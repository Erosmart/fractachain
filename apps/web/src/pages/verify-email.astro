---
import VerifyEmailPage from '@/features/auth/components/VerifyEmailPage';
import PageFallback from '@/components/ui/PageFallback.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { translate } from '@/core/i18n/translate';

const locale = Astro.locals.locale;
---

<BaseLayout title={translate(locale, 'verify.title')}>
  <VerifyEmailPage client:only="react" locale={locale}>
    <PageFallback slot="fallback" />
  </VerifyEmailPage>
</BaseLayout>
