---
import TermsPage from '@/features/onboarding/components/TermsPage';
import PageFallback from '@/components/ui/PageFallback.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { translate } from '@/core/i18n/translate';

const locale = Astro.locals.locale;
---

<BaseLayout title={translate(locale, 'onboard.terms.title')} bare>
  <TermsPage client:only="react" locale={locale}>
    <PageFallback slot="fallback" />
  </TermsPage>
</BaseLayout>
