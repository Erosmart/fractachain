---
import KycCallbackPage from '@/features/onboarding/components/KycCallbackPage';
import PageFallback from '@/components/ui/PageFallback.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { translate } from '@/core/i18n/translate';

/**
 * Didit's redirect target (`${APP_URL}/onboarding/kyc/callback`). The query
 * string it appends is never trusted: the island asks the API to re-read the
 * decision from Didit.
 */
const locale = Astro.locals.locale;
---

<BaseLayout title={translate(locale, 'onboard.callback.title')} bare>
  <KycCallbackPage client:only="react" locale={locale}>
    <PageFallback slot="fallback" />
  </KycCallbackPage>
</BaseLayout>
