---
import KycOnboardingPage from '@/features/onboarding/components/KycOnboardingPage';
import PageFallback from '@/components/ui/PageFallback.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { translate } from '@/core/i18n/translate';

const locale = Astro.locals.locale;
---

<BaseLayout title={translate(locale, 'onboarding.kycTitle')}>
  <KycOnboardingPage client:only="react" locale={locale}>
    <PageFallback slot="fallback" />
  </KycOnboardingPage>
</BaseLayout>
