---
import OrderbookPage from '@/features/orderbook/components/OrderbookPage';
import MarketsHeader from '@/features/market/components/MarketsHeader.astro';
import PageFallback from '@/components/ui/PageFallback.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { translate } from '@/core/i18n/translate';

const locale = Astro.locals.locale;
---

<BaseLayout title={translate(locale, 'markets.orderbook.title')}>
  <MarketsHeader active="orderbook" title="markets.orderbook.title" subtitle="markets.orderbook.subtitle" />
  <OrderbookPage client:only="react" locale={locale}>
    <PageFallback slot="fallback" />
  </OrderbookPage>
</BaseLayout>
