---
import { ArrowRight, BookOpen, Building2, Info } from 'lucide-react';
import IssuerSimulator from '@/features/issuers/components/IssuerSimulator';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { messagesFor } from '@/core/i18n/translate';

const locale = Astro.locals.locale;
const { landing } = messagesFor(locale);
const p = landing.issuerPage;
---

<BaseLayout title={p.title} description={p.lead}>
  <div class="mx-auto max-w-[1180px] space-y-10">
    <header class="max-w-3xl">
      <p class="eyebrow">{p.eyebrow}</p>
      <h1 class="mt-2 text-[30px] font-normal leading-tight tracking-[-0.025em] text-ink sm:text-[38px]">
        {p.title}
      </h1>
      <p class="mt-3 text-[15px] leading-relaxed text-ink-2 sm:text-base">{p.lead}</p>
      <div class="mt-6 flex flex-col gap-2.5 sm:flex-row">
        <a href="/contact?topic=issuer" class="btn btn-primary btn-lg">
          <Building2 className="h-4 w-4" aria-hidden="true" />
          {p.cta}
          <ArrowRight className="h-4 w-4" aria-hidden="true" />
        </a>
        <a href="/market" class="btn btn-secondary btn-lg">
          {p.ctaSecondary}
        </a>
      </div>
    </header>

    <section aria-labelledby="steps-title" class="space-y-4">
      <h2 id="steps-title" class="text-[17px] font-medium text-ink">
        {p.stepsTitle}
      </h2>
      <ol class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
        {p.steps.map(([title, body], i) => (
          <li class="card card-pad flex min-w-0 flex-col">
            <span class="chip-navy w-fit">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-5 text-[15px] font-medium leading-snug text-ink">{title}</h3>
            <p class="mt-1.5 text-sm text-ink-2">{body}</p>
          </li>
        ))}
      </ol>
    </section>

    <IssuerSimulator client:only="react" locale={locale}>
      <div slot="fallback" class="card card-pad min-h-[420px]" aria-hidden="true"></div>
    </IssuerSimulator>

    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_380px]">
      <section aria-labelledby="glossary-title" class="card card-pad">
        <h2 id="glossary-title" class="title flex items-center gap-2">
          <BookOpen className="h-4 w-4 text-ink-2" aria-hidden="true" />
          {p.glossaryTitle}
        </h2>
        <dl class="mt-4 grid gap-4 sm:grid-cols-2">
          {p.glossary.map(([term, def]) => (
            <div>
              <dt class="text-sm font-medium text-ink">{term}</dt>
              <dd class="mt-0.5 text-[13px] leading-relaxed text-ink-2">{def}</dd>
            </div>
          ))}
        </dl>
        <a href="/help#glossary" class="mt-5 inline-flex text-sm text-ink underline underline-offset-2">
          {messagesFor(locale).legal.help.title}
        </a>
      </section>
      <aside class="space-y-4">
        <div class="flex gap-3 rounded-2xl bg-peach-soft px-4 py-3.5 text-ink">
          <Info className="mt-0.5 h-4 w-4 shrink-0 text-ink-2" aria-hidden="true" />
          <p class="text-[13px] leading-relaxed text-ink-2">
            {landing.risk.short} {p.fees}
          </p>
        </div>
        <div class="gradient-panel p-5 sm:p-6">
          <p class="title">{landing.elevators.title}</p>
          <p class="mt-1.5 text-[13px] leading-relaxed text-ink-2">{landing.elevators.lead}</p>
          <a href="/contact?topic=issuer" class="btn btn-primary mt-4">
            {landing.elevators.cta}
          </a>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
