---
import '@/styles/global.css';
import CrystalBackdrop from '@/components/layout/CrystalBackdrop.astro';
import Footer from '@/components/layout/Footer.astro';
import Navbar from '@/components/layout/Navbar';
import { messagesFor } from '@/core/i18n/translate';
import { THEME_BOOTSTRAP_SCRIPT } from '@/core/security/csp.mjs';

interface Props {
  /** Page-specific `<title>`; defaults to the site title. */
  title?: string;
  description?: string;
}

const locale = Astro.locals.locale;
const meta = messagesFor(locale).meta;
const title = Astro.props.title ? `${Astro.props.title} · Fractachain` : meta.title;
const description = Astro.props.description ?? meta.description;
const FONTS =
  'https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,300;0,400;0,700;0,900;1,300;1,400;1,700;1,900' +
  '&family=Share+Tech+Mono&family=Source+Serif+4:ital,wght@1,700;1,800&display=swap';
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={FONTS} />
    <script is:inline set:html={THEME_BOOTSTRAP_SCRIPT} />
    <slot name="head" />
  </head>
  <body class="relative min-h-screen bg-white text-black flex flex-col font-body selection:bg-leaf-200 selection:text-black">
    <CrystalBackdrop />
    <Navbar client:load locale={locale} pathname={Astro.url.pathname} />
    <main class="relative z-10 flex-1 w-full max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 pt-3 sm:pt-4 pb-8 sm:pb-10">
      <slot />
    </main>
    <Footer />
  </body>
</html>
