---
/**
 * Server-rendered placeholder shown while a `client:only` island loads.
 * Usage: `<Page client:only="react"><PageFallback slot="fallback" /></Page>`.
 */
import { translate } from '@/core/i18n/translate';

interface Props {
  messageKey?: string;
}

const text = translate(Astro.locals.locale, Astro.props.messageKey ?? 'misc.loading');
---

<div class="flex items-center justify-center gap-2.5 py-16 text-sm text-muted" role="status" aria-busy="true">
  <span
    class="h-4 w-4 animate-spin rounded-full border-2 border-line border-t-sky-strong motion-reduce:animate-none"
    aria-hidden="true"
  ></span>
  {text}
</div>
