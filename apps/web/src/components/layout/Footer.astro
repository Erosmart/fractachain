---
import { Info } from 'lucide-react';
import BrandMark from '@/components/ui/BrandMark';
import { messagesFor, translatorFor } from '@/core/i18n/translate';
import FooterAdminLinks from './FooterAdminLinks';

const locale = Astro.locals.locale;
const t = translatorFor(locale);
const f = messagesFor(locale).landing.footer;
const lf = messagesFor(locale).legal.footer;
const year = new Date().getFullYear();

const columns = [
  {
    title: f.offerings,
    links: [
      { href: '/market', label: f.allOfferings },
      { href: '/#how-it-works', label: f.howItWorks },
      { href: '/#issuers', label: f.issuers },
    ],
  },
  {
    title: f.markets,
    links: [
      { href: '/orderbook', label: f.secondary },
      { href: '/stocks', label: f.merval },
      { href: '/forwards', label: f.derivatives },
    ],
  },
  {
    title: f.portfolio,
    links: [
      { href: '/dashboard', label: f.dashboard },
      { href: '/portfolio', label: f.holdings },
    ],
  },
  {
    title: f.account,
    links: [
      { href: '/wallet', label: f.wallet },
      { href: '/account/security', label: f.security },
      { href: '/login', label: f.signIn },
    ],
  },
  {
    title: lf.resources,
    links: [
      { href: '/help', label: lf.help },
      { href: '/contact', label: lf.contact },
      { href: '/transparency', label: lf.transparency },
    ],
  },
  {
    title: lf.legal,
    links: [
      { href: '/legal/terms', label: lf.terms },
      { href: '/legal/privacy', label: lf.privacy },
      { href: '/legal/cookies', label: lf.cookies },
      { href: '/legal/risks', label: lf.risks },
    ],
  },
];
---

<footer class="relative z-10 mt-8 border-t border-line/70 bg-surface/60 pb-28 pt-12 text-sm backdrop-blur-sm lg:pb-10">
  <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)]">
      <div class="max-w-sm space-y-4">
        <BrandMark />
        <p class="text-ink-2">{f.blurb}</p>
        <span class="chip chip-butter dark:text-navy-ink">{f.testnet}</span>
      </div>
      <nav class="grid grid-cols-2 gap-8 sm:grid-cols-3 xl:grid-cols-6" aria-label={f.navLabel}>
        {columns.map((col) => (
          <div>
            <h2 class="mb-3 text-xs font-medium text-muted">{col.title}</h2>
            <ul class="space-y-2.5">
              {col.links.map((l) => (
                <li>
                  <a href={l.href} class="text-ink-2 transition-colors hover:text-ink">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
        <FooterAdminLinks client:only="react" locale={locale} />
      </nav>
    </div>

    <div class="mt-10 grid gap-3 lg:grid-cols-2">
      <div class="flex gap-3 rounded-2xl bg-peach-soft px-4 py-3.5 text-ink">
        <Info className="mt-0.5 h-4 w-4 shrink-0 text-ink-2" aria-hidden="true" />
        <p class="text-[13px] leading-relaxed">{messagesFor(locale).landing.risk.short}</p>
      </div>
      <div class="rounded-2xl border border-line bg-surface px-4 py-3.5">
        <p class="text-xs font-medium text-ink">{f.legalTitle}</p>
        <p class="mt-1 text-xs leading-relaxed text-ink-2">{t('footer.legal')}</p>
        <p class="mt-2 text-xs">
          <a href="/legal/risks" class="text-ink underline underline-offset-2">
            {lf.risks}
          </a>
        </p>
      </div>
    </div>

    <div class="mt-8 flex items-center justify-between border-t border-line pt-6 text-xs text-muted">
      <p>
        © {year} {f.rights}
      </p>
      <p>Stellar · Soroban</p>
    </div>
  </div>
</footer>
