---
import { MERVAL_NAMES } from '@/core/market/brands';
import { messagesFor } from '@/core/i18n/translate';

const { merval, products } = messagesFor(Astro.locals.locale);
const loop = [...MERVAL_NAMES, ...MERVAL_NAMES];
---

<section class="space-y-8">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
    <div class="space-y-2">
      <p class="font-lcd text-[11px] uppercase tracking-[0.22em] text-neutral-500">{merval.kicker}</p>
      <div class="flex flex-wrap items-center gap-3 mt-1">
        <h2 class="font-section text-3xl sm:text-4xl font-extrabold text-black">{merval.title}</h2>
        <span class="inline-flex items-center px-3 py-1.5 rounded-full border border-black/10 bg-black/[0.04] text-xs font-section font-bold uppercase tracking-wider text-neutral-500">
          {products.roadmap}
        </span>
      </div>
    </div>
    <p class="text-sm text-neutral-600 max-w-md">{merval.lead}</p>
  </div>
  <div class="merval-reel opacity-80">
    <div class="merval-reel-track">
      {loop.map((c, i) => (
        <div
          aria-label={c.name}
          aria-hidden={i >= MERVAL_NAMES.length ? 'true' : undefined}
          class="flex items-center justify-center h-[88px] min-w-[140px] px-4 shrink-0"
        >
          <img
            src={`/brands/${c.ticker.toLowerCase()}.png`}
            alt={i >= MERVAL_NAMES.length ? '' : c.name}
            class="h-14 w-auto max-w-[140px] object-contain opacity-70"
            loading="lazy"
            decoding="async"
          />
        </div>
      ))}
    </div>
  </div>
  <div class="flex flex-wrap gap-3">
    <a
      href="/market"
      class="px-6 py-3.5 rounded-2xl bg-white/80 border border-black/10 text-black font-section font-bold text-sm"
    >
      {merval.ctaBonds}
    </a>
  </div>
  <p class="text-sm text-neutral-600 max-w-3xl border-l-2 border-[#4ea743] pl-4">{merval.stake}</p>
</section>
