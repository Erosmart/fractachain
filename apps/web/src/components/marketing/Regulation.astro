---
import { FileCheck2, Landmark, ShieldCheck, Vault } from 'lucide-react';
import { messagesFor } from '@/core/i18n/translate';

const { landing } = messagesFor(Astro.locals.locale);
const r = landing.regulation;
const icons = [Landmark, Vault, FileCheck2, ShieldCheck];
---

<section
  aria-labelledby="regulation-title"
  class="gradient-panel grid gap-8 p-6 sm:p-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-12"
>
  <div class="min-w-0">
    <p class="mb-2 text-xs font-medium text-ink-2">{r.eyebrow}</p>
    <h2
      id="regulation-title"
      class="text-[28px] font-normal leading-tight tracking-[-0.025em] sm:text-[36px]"
    >
      {r.title}
    </h2>
    <p class="mt-3 text-[15px] text-ink-2">{r.lead}</p>
    <p class="mt-6 inline-flex rounded-xl bg-ink/[0.06] px-4 py-3 text-[13px] font-medium">{r.note}</p>
  </div>
  <ul class="grid gap-3 sm:grid-cols-2">
    {r.items.map(([title, body], i) => {
      const Icon = icons[i];
      return (
        <li class="rounded-2xl bg-surface/75 p-5 backdrop-blur-sm">
          <Icon className="h-5 w-5 text-ink-2" aria-hidden="true" />
          <h3 class="mt-4 text-[15px] font-medium text-ink">{title}</h3>
          <p class="mt-1 text-sm text-ink-2">{body}</p>
        </li>
      );
    })}
  </ul>
</section>
