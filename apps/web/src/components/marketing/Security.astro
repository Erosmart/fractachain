---
import { FileClock, KeyRound, ScanFace, Wallet } from 'lucide-react';
import { messagesFor } from '@/core/i18n/translate';
import SectionHeading from './SectionHeading.astro';

const { landing } = messagesFor(Astro.locals.locale);
const s = landing.security;
const icons = [KeyRound, Wallet, ScanFace, FileClock];
---

<section aria-labelledby="security-title" class="space-y-6">
  <SectionHeading id="security-title" eyebrow={s.eyebrow} title={s.title} />
  <ul class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    {s.items.map(([title, body], i) => {
      const Icon = icons[i];
      return (
        <li class="card card-pad">
          <Icon className="h-5 w-5 text-ink-2" aria-hidden="true" />
          <h3 class="mt-5 text-[15px] font-medium text-ink">{title}</h3>
          <p class="mt-1 text-sm text-ink-2">{body}</p>
        </li>
      );
    })}
  </ul>
</section>
