---
import { Building2, Wallet } from 'lucide-react';
import { partnerSlug } from '@/core/market/brands';
import { messagesFor } from '@/core/i18n/translate';

const messages = messagesFor(Astro.locals.locale);
const funding = messages.partners.funding;
const ptn = messages.ptn as Record<string, { role: string; description: string; badge: string }>;

const PARTNERS = [
  'BYMA',
  'Caja de Valores',
  'Stellar Foundation',
  'Alfred Pay',
  'Matba Rofex',
  'Anclap',
  'Circle CCTP',
];
const FUNDING_LOGOS: ({ slug: string; alt: string } | null)[] = [
  { slug: 'alfred-pay', alt: 'Alfred Pay' },
  { slug: 'moneygram', alt: 'MoneyGram' },
  null,
];
---

<section class="space-y-6">
  <div class="space-y-4">
    <div class="space-y-1">
      <h2 class="font-section text-3xl font-extrabold text-black">{funding.title}</h2>
      <p class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-50 border border-amber-300/80 text-amber-900 text-xs">
        {funding.demo}
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      {funding.items.map((item, i) => {
        const logo = FUNDING_LOGOS[i];
        return (
          <div class="p-5 rounded-2xl crystal-card space-y-3">
            <div class="flex items-start justify-between gap-2">
              {logo ? (
                <img
                  src={`/brands/${logo.slug}.png`}
                  alt={logo.alt}
                  class="h-7 w-auto max-h-7 max-w-[6rem] object-contain object-left"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="inline-flex h-7 w-7 items-center justify-center rounded-lg border border-black/10 bg-white/80">
                  <Wallet className="h-4 w-4 text-[#4ea743]" />
                </span>
              )}
              <span class="text-[10px] font-lcd text-neutral-500 bg-white/80 px-2 py-0.5 rounded border border-black/10 shrink-0">
                {item.tag}
              </span>
            </div>
            <div>
              <div class="text-sm font-display font-bold text-black">{item.title}</div>
              <p class="text-xs text-neutral-600 mt-1 leading-relaxed">{item.body}</p>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pt-4">
    <div class="space-y-1">
      <div class="inline-flex items-center gap-2 text-xs font-display font-bold text-neutral-500 uppercase tracking-wider">
        <Building2 className="w-4 h-4" />
        Building blocks
      </div>
      <h2 class="font-section text-3xl font-extrabold text-black">{messages.partners.title}</h2>
    </div>
    <p class="text-sm text-neutral-600 max-w-md">{messages.partners.lead}</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {PARTNERS.map((name) => {
      const slug = partnerSlug(name);
      const copy = ptn[slug];
      return (
        <div class="p-5 rounded-2xl crystal-card space-y-3">
          <div class="flex items-start justify-between gap-2 flex-wrap">
            <img
              src={`/brands/${slug}.png`}
              alt={name}
              class="h-8 w-auto max-h-8 max-w-[6.5rem] object-contain object-left"
              loading="lazy"
              decoding="async"
            />
            <span class="text-[10px] font-lcd text-neutral-500 bg-white/80 px-2 py-0.5 rounded border border-black/10 shrink-0">
              {copy?.badge}
            </span>
          </div>
          <div>
            <div class="text-sm font-display font-bold text-black">{copy?.role}</div>
            <p class="text-xs text-neutral-600 mt-1 leading-relaxed">{copy?.description}</p>
          </div>
        </div>
      );
    })}

    <!-- Highlight Card: SCF Argentina Builder Challenge -->
    <div class="p-5 rounded-2xl crystal-card flex flex-col justify-between space-y-3">
      <div class="space-y-2">
        <img
          src="/brands/scf.png"
          alt="Stellar Community Fund"
          class="h-8 w-auto max-w-[7rem] object-contain"
          loading="lazy"
          decoding="async"
        />
        <div class="text-sm font-display font-bold text-black">Stellar Community Fund</div>
        <p class="text-xs text-neutral-600 leading-relaxed">{messages.partners.scf}</p>
      </div>
      <div class="pt-2 border-t border-black/10 flex items-center justify-between text-[11px] font-lcd text-neutral-600">
        <span>Salta 2026</span>
        <span class="font-bold text-black">Instawards</span>
      </div>
    </div>
  </div>
</section>
