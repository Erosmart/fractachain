---
import { ArrowRight, Building2, Check } from 'lucide-react';
import { messagesFor } from '@/core/i18n/translate';

const { landing } = messagesFor(Astro.locals.locale);
const s = landing.issuers;
---

<section id="emisores" aria-labelledby="issuers-title" class="card scroll-mt-24 overflow-hidden">
  <div class="grid lg:grid-cols-2">
    <div class="p-6 sm:p-10">
      <p class="eyebrow mb-2">{s.eyebrow}</p>
      <h2
        id="issuers-title"
        class="text-[28px] font-normal leading-tight tracking-[-0.025em] text-ink sm:text-[36px]"
      >
        {s.title}
      </h2>
      <p class="mt-3 text-[15px] text-ink-2">{s.lead}</p>
      <a href="/contacto?tema=emisor" class="btn btn-primary btn-lg mt-8">
        <Building2 className="h-4 w-4" aria-hidden="true" />
        {s.cta}
        <ArrowRight className="h-4 w-4" aria-hidden="true" />
      </a>
    </div>
    <ul class="flex flex-col justify-center gap-3 border-t border-line bg-surface-2 p-6 sm:p-10 lg:border-l lg:border-t-0">
      {s.points.map(([title, body]) => (
        <li class="flex items-start gap-3 rounded-2xl border border-line bg-surface px-4 py-3.5">
          <span
            class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-navy text-navy-ink"
            aria-hidden="true"
          >
            <Check className="h-4 w-4" strokeWidth={2.5} />
          </span>
          <span class="min-w-0">
            <span class="block text-sm font-medium text-ink">{title}</span>
            <span class="mt-0.5 block text-[13px] text-muted">{body}</span>
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>
