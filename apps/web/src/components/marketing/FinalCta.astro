---
import { messagesFor } from '@/core/i18n/translate';
import { WireframeAsset } from '@/components/ui/kit';

const { landing } = messagesFor(Astro.locals.locale);
const c = landing.cta;
---

<section
  aria-labelledby="cta-title"
  class="gradient-panel relative overflow-hidden px-6 py-12 sm:px-12 sm:py-16"
>
  <div class="relative z-10 max-w-xl">
    <h2 id="cta-title" class="text-[32px] font-light leading-tight tracking-[-0.03em] sm:text-[44px]">
      {c.title}
    </h2>
    <p class="mt-3 text-[15px] text-ink-2">{c.lead}</p>
    <div class="mt-8 flex flex-col gap-2.5 sm:flex-row">
      <a href="/register" class="btn btn-primary btn-lg">
        {c.primary}
      </a>
      <a href="/market" class="btn btn-lg bg-surface/70 text-ink hover:bg-surface">
        {c.secondary}
      </a>
    </div>
    <p class="mt-8 text-xs text-ink-2">{landing.risk.long}</p>
  </div>
  <WireframeAsset className="pointer-events-none absolute -bottom-10 -right-24 hidden w-[620px] opacity-60 lg:block" />
</section>
