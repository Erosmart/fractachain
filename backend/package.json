{
  "name": "fractachain-backend",
  "version": "1.0.0",
  "description": "Fractachain Administration, KYC, Custody and Mocks Backend API (Railway Ready)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node --use-system-ca dist/server.js",
    "dev": "node --use-system-ca ./node_modules/ts-node-dev/lib/bin.js --respawn --transpile-only src/server.ts",
    "test": "node --use-system-ca ./node_modules/ts-node/dist/bin.js src/test_runner.ts",
    "deploy:licitacion": "node --use-system-ca ./node_modules/ts-node/dist/bin.js src/stellar/deploy_licitacion.ts",
    "deploy:forward-warrant": "node --use-system-ca ./node_modules/ts-node/dist/bin.js src/stellar/deploy_forward_warrant.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
